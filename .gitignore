# ==========================================
# EdTech Portfolio - Git Ignore Specification
# ==========================================

# 1. 敏感憑證與私鑰 (嚴禁上傳)
.env
.env.local
*.pem
*.cert
secret.json
.dev.vars
.dev.vars.*

# 2. 相依套件目錄
node_modules/
.pnp
.pnp.js

# 3. 系統與編輯器暫存檔
.DS_Store
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# 4. 建置與編譯輸出 (未來擴充用)
dist/
build/
.next/
out/

# 5. Cloudflare Workers 本機狀態 (miniflare 模擬資料，不進版控)
.wrangler/
tools/og/home.png

# Playwright MCP 截圖（子代理自檢用，不進版控）
.playwright-mcp/
